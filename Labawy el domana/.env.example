# Runtime: Neon pooled URL; local Docker URL shown in README.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Migrations/CLI: Neon direct URL. Never point development/test at production.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
APP_URL=http://localhost:3000
# Required in production; random 32+ bytes, e.g. openssl rand -hex 32
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET
# Dedicated disposable PostgreSQL database; name must include test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/domino_test
